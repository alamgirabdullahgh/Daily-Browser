<?xml version="1.0" encoding="utf-8"?>
<!-- শুধু Android-এর প্যাকেজ-ইনস্টলার অ্যাপের পর্দায় চলে; আর কোনো অ্যাপের ঘটনা এই সার্ভিস পায় না -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="300"
    android:canRetrieveWindowContent="true"
    android:packageNames="com.google.android.packageinstaller,com.android.packageinstaller,com.samsung.android.packageinstaller,com.miui.packageinstaller,com.oplus.appdetail,com.coloros.packageinstaller,com.oppo.packageinstaller"
    android:description="@string/a11y_desc" />
